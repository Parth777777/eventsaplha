<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tickwave | Home</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: { extend: { colors: {
                "primary": "#8eb4e0", "primary-container": "#3a6ea8", "secondary": "#2dd4aa", "tertiary": "#f29090",
                "error": "#f26b6b", "background": "#080c12", "surface": "#0d1118",
                "surface-container-lowest": "#060a0f", "surface-container-low": "#0d1118",
                "surface-container": "#111720", "surface-container-high": "#161d28",
                "surface-container-highest": "#1c2435", "surface-bright": "#222c3d",
                "on-surface": "#dde3ef", "on-surface-variant": "#8a94a8",
                "outline": "#3d4a5c", "outline-variant": "#253040",
                "bull": "#2dd4aa", "bear": "#f26b6b", "caution": "#e6b84a", "info": "#6ba3d6"
            }, fontFamily: { "headline": ["Plus Jakarta Sans"], "body": ["DM Sans"], "mono": ["JetBrains Mono"] } } }
        }
    </script>
    <link rel="stylesheet" href="./shared/css/style.css">
    <script src="./shared/js/theme.js"></script>
    <script src="./shared/js/widgets.js"></script>
    <style>.material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }</style>
</head>
<body class="bg-background text-on-surface font-body">

<aside class="sidebar hidden md:flex">
    <div class="sidebar-header">
        <h1 class="sidebar-brand">Tickwave</h1>
        <p class="sidebar-brand-sub">Alpha Terminal</p>
    </div>
    <nav class="sidebar-nav">
      <a class="sidebar-link active" href="index.html"><span class="material-symbols-outlined sidebar-icon">home</span>Home</a>
      <a class="sidebar-link" href="explore.html"><span class="material-symbols-outlined sidebar-icon">electric_bolt</span>Signals</a>
      <a class="sidebar-link" href="events.html"><span class="material-symbols-outlined sidebar-icon">event</span>Events</a>
      <a class="sidebar-link" href="map.html"><span class="material-symbols-outlined sidebar-icon">public</span>Markets</a>
      <a class="sidebar-link" href="sectors.html"><span class="material-symbols-outlined sidebar-icon">grid_view</span>Sectors</a>
      <a class="sidebar-link" href="watchlist.html"><span class="material-symbols-outlined sidebar-icon">star</span>Watchlist</a>
      <a class="sidebar-link" href="screeners.html"><span class="material-symbols-outlined sidebar-icon">filter_alt</span>Screeners</a>
      <a class="sidebar-link" href="portfolio.html"><span class="material-symbols-outlined sidebar-icon">account_balance_wallet</span>Portfolio</a>
      <a class="sidebar-link" href="analytics.html"><span class="material-symbols-outlined sidebar-icon">insights</span>Insights</a>
      <a class="sidebar-link" href="alerts.html"><span class="material-symbols-outlined sidebar-icon">notifications_active</span>Alerts</a>
      <a class="sidebar-link" href="global.html"><span class="material-symbols-outlined sidebar-icon">language</span>Global</a>
      <a class="sidebar-link" href="commodities.html"><span class="material-symbols-outlined sidebar-icon">inventory_2</span>Commodities</a>
      <a class="sidebar-link" href="compare.html"><span class="material-symbols-outlined sidebar-icon">compare_arrows</span>Compare</a>
    </nav>
    <div class="mt-auto pt-6 border-t border-outline-variant/15 px-6">
        <div class="engine-status p-4 rounded-lg">
            <p class="text-[10px] text-on-surface-variant mb-2 uppercase tracking-widest font-bold">Engine Status</p>
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <div class="w-1.5 h-1.5 rounded-full bg-secondary animate-pulse"></div>
                    <span class="text-xs font-bold text-on-surface uppercase">Active</span>
                </div>
                <span class="text-[10px] text-on-surface-variant/60 font-mono">v4.2.9</span>
            </div>
            <div class="space-y-1.5">
                <div class="flex justify-between items-center text-[9px] text-on-surface-variant">
                    <span>Latency</span>
                    <span class="text-secondary font-mono">14ms</span>
                </div>
                <div class="w-full bg-surface-container-lowest h-1 rounded-full overflow-hidden">
                    <div class="bg-secondary/40 h-full w-[88%]"></div>
                </div>
            </div>
        </div>
    </div>
    <div id="authStatus" class="mt-auto pt-4 border-t border-outline-variant/15 px-6"></div>
</aside>

<main class="main-content">
    <header class="sticky top-0 z-40 bg-background/85 backdrop-blur border-b border-outline-variant/10 px-6 py-2.5 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary" style="font-size:20px;">graphic_eq</span>
            <span class="font-headline font-black text-base tracking-wide">Tickwave</span>
            <span class="hidden lg:inline text-[9px] text-on-surface-variant/50 font-mono ml-2 pl-2 border-l border-outline-variant/20">LIVE MARKETS</span>
        </div>
        <!-- Market Ticker Strip -->
        <div id="headerTicker" class="hidden lg:flex items-center gap-2 flex-1 overflow-x-auto scrollbar-hide px-2">
            <!-- populated by renderMarketPulse() -->
            <span class="skeleton h-6 w-24 rounded"></span>
            <span class="skeleton h-6 w-24 rounded"></span>
            <span class="skeleton h-6 w-24 rounded"></span>
            <span class="skeleton h-6 w-24 rounded"></span>
            <span class="skeleton h-6 w-24 rounded"></span>
            <span class="skeleton h-6 w-24 rounded"></span>
        </div>
        <div class="flex items-center gap-3 ml-auto">
            <div id="statusBanner" style="min-width:140px;text-align:right;font-size:11px;"></div>
            <button onclick="const on = SoundFX.toggle(); this.querySelector('span').textContent = on ? 'volume_up' : 'volume_off'" class="p-2 text-on-surface-variant hover:bg-surface-container rounded transition-colors" title="Toggle alert sounds">
                <span class="material-symbols-outlined text-sm">volume_up</span>
            </button>
        </div>
    </header>

    <!-- ============ HERO DASHBOARD ============ -->
    <section class="relative overflow-hidden mx-2 md:mx-4 mt-4 mb-6 rounded-2xl border border-outline-variant/10"
             style="background:rgba(13,17,24,0.5);backdrop-filter:blur(8px);">

        <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 p-4">
            <!-- Panel 1: Live Event Detected (3/5) -->
            <div id="heroPanelEvent" class="lg:col-span-3 bg-surface-container-low rounded-xl border border-outline-variant/10 p-5 min-h-[260px]">
                <div class="flex items-center gap-2 mb-4">
                    <span class="w-1.5 h-1.5 rounded-full bg-error animate-pulse"></span>
                    <span class="text-[9px] font-black tracking-[0.25em] uppercase text-on-surface-variant">Live Event Detected</span>
                </div>
                <div id="heroPanelEventBody" class="flex-1">
                    <div class="skeleton mb-3" style="height:28px;width:80%;border-radius:4px;"></div>
                    <div class="flex gap-2 mb-4">
                        <span class="skeleton h-5 w-16 rounded-full"></span>
                        <span class="skeleton h-5 w-20 rounded-full"></span>
                    </div>
                    <div class="space-y-2">
                        <span class="skeleton h-3 w-full rounded"></span>
                        <span class="skeleton h-3 w-full rounded"></span>
                        <span class="skeleton h-3 w-2/3 rounded"></span>
                    </div>
                </div>
            </div>

            <!-- Panel 2: Top Trades (1/5) -->
            <div id="heroPanelTrades" class="lg:col-span-1 bg-surface-container-low rounded-xl border border-outline-variant/10 p-4 min-h-[260px]">
                <div class="text-[9px] font-black tracking-[0.25em] uppercase text-on-surface-variant mb-3">Top Trades</div>
                <div id="heroPanelTradesBody" class="space-y-3 text-sm">
                    <div class="skeleton h-16 rounded"></div>
                    <div class="skeleton h-16 rounded"></div>
                    <div class="skeleton h-16 rounded"></div>
                </div>
            </div>

            <!-- Panel 3: Market State (1/5) -->
            <div id="heroPanelState" class="lg:col-span-1 bg-surface-container-low rounded-xl border border-outline-variant/10 p-4 min-h-[260px]">
                <div class="text-[9px] font-black tracking-[0.25em] uppercase text-on-surface-variant mb-4">Market State</div>
                <div id="heroPanelStateBody" class="flex flex-col h-full">
                    <div class="mb-4">
                        <div class="skeleton h-24 w-full rounded mb-3"></div>
                        <div class="skeleton h-5 w-2/3 rounded"></div>
                    </div>
                    <div class="text-xs space-y-2 mt-auto">
                        <div class="flex justify-between"><span class="text-on-surface-variant/70">Advance/Decline</span><span class="skeleton h-4 w-12 rounded"></span></div>
                        <div class="flex justify-between"><span class="text-on-surface-variant/70">Market Breadth</span><span class="skeleton h-4 w-12 rounded"></span></div>
                        <div class="flex justify-between"><span class="text-on-surface-variant/70">Volatility</span><span class="skeleton h-4 w-12 rounded"></span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- ============ END HERO DASHBOARD ============ -->
    
    <!-- Live Market Pulse Panel — HIDDEN for minimal UI -->
    <div class="mb-8 hidden" id="marketPulsePanel">
        <div class="flex items-center gap-2 mb-3">
            <div class="w-1.5 h-1.5 rounded-full bg-secondary animate-pulse"></div>
            <h3 class="text-[10px] font-black tracking-[0.25em] uppercase text-on-surface-variant">Live Market Pulse</h3>
            <div class="h-[1px] flex-1 bg-outline-variant/20"></div>
            <span class="text-[9px] text-on-surface-variant/40 font-mono" id="pulseUpdated">fetching...</span>
        </div>
        <div id="pulseIndices" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
            <!-- skeleton -->
            <div class="skeleton rounded-xl" style="height:96px;"></div>
            <div class="skeleton rounded-xl" style="height:96px;"></div>
            <div class="skeleton rounded-xl" style="height:96px;"></div>
            <div class="skeleton rounded-xl" style="height:96px;"></div>
            <div class="skeleton rounded-xl hidden lg:block" style="height:96px;"></div>
            <div class="skeleton rounded-xl hidden lg:block" style="height:96px;"></div>
        </div>
        <!-- Derived market trend bar -->
        <div id="pulseTrendBar" class="mt-4 rounded-lg border border-outline-variant/10 px-4 py-3 text-xs" style="background:rgba(28,32,38,0.6); display:flex; flex-wrap:wrap; align-items:center; gap:10px 16px; row-gap:6px;">
            <span class="skeleton" style="width:200px;height:14px;border-radius:4px;display:inline-block;"></span>
            <span class="skeleton" style="width:80px;height:14px;border-radius:4px;display:inline-block;"></span>
        </div>
    </div>

    <!-- Key Metrics Grid — hidden in simplified FTUE; reachable from Analytics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8" style="display:none;">
        <div class="pastel-card pastel-card--mint">
            <div class="pastel-card__head">
                <span class="pastel-card__chip">
                    <span class="pastel-card__icon-bg"><span class="material-symbols-outlined">speed</span></span>
                    India VIX
                </span>
                <span class="delta" id="metricVIXDelta" style="display:none;">—</span>
            </div>
            <div class="pastel-card__value" id="metricVIX">—</div>
            <div class="pastel-card__sub" id="metricVIXLabel">fear gauge</div>
        </div>

        <div class="pastel-card pastel-card--yellow">
            <div class="pastel-card__head">
                <span class="pastel-card__chip">
                    <span class="pastel-card__icon-bg"><span class="material-symbols-outlined">bolt</span></span>
                    Live Signals
                </span>
                <span class="delta">+24h</span>
            </div>
            <div class="pastel-card__value" id="metricSignals">—</div>
            <div class="pastel-card__sub">active signals on the book</div>
        </div>

        <div class="pastel-card pastel-card--lavender">
            <div class="pastel-card__head">
                <span class="pastel-card__chip">
                    <span class="pastel-card__icon-bg"><span class="material-symbols-outlined">psychology</span></span>
                    Avg Confidence
                </span>
            </div>
            <div class="pastel-card__value" id="metricConfidence">—</div>
            <div class="pastel-card__sub">NLP confidence score</div>
        </div>

        <div class="pastel-card pastel-card--dark">
            <div class="pastel-card__head">
                <span class="pastel-card__chip" style="background:rgba(255,255,255,0.10);color:inherit;">
                    <span class="pastel-card__icon-bg" style="background:rgba(255,255,255,0.10);"><span class="material-symbols-outlined">bar_chart</span></span>
                    Events Today
                </span>
                <span class="delta" style="background:rgba(200,245,98,0.20);color:var(--accent-lime);">live</span>
            </div>
            <div class="pastel-card__value" id="metricEvents">—</div>
            <div class="pastel-card__sub" style="opacity:0.7;">events processed in last 24h</div>
        </div>
    </div>
    
    <!-- ============ INSIGHTS STUDIO (mounted from shared/js/widgets.js) — HIDDEN for minimal UI ============ -->
    <div id="insightsRoot" class="mb-8 hidden"></div>

    <!-- Sector Concentration Warning -->
    <div id="concentrationWarning" class="hidden mb-6 px-4 py-3 rounded-xl border flex items-center gap-3" style="background:rgba(255,178,183,0.06);border-color:rgba(255,178,183,0.2);">
        <span class="material-symbols-outlined text-base flex-shrink-0" style="color:#ffb2b7;">warning</span>
        <div class="flex-1">
            <span class="text-xs font-bold" style="color:#ffb2b7;">Sector Concentration Risk</span>
            <span id="concentrationText" class="text-xs text-on-surface-variant ml-2"></span>
        </div>
        <a href="analytics.html" class="text-[9px] px-2 py-1 rounded font-bold hover:opacity-80 transition-opacity flex-shrink-0" style="background:rgba(255,178,183,0.12);color:#ffb2b7;border:1px solid rgba(255,178,183,0.2);">View Analytics →</a>
    </div>

    <!-- Quant Tools CTA Row — hidden; primary CTAs live in the hero now -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6 px-2" style="display:none;">
        <a href="portfolio.html" class="flex items-center justify-between p-4 rounded-xl group transition-all duration-200 hover:scale-[1.01]"
           style="background:linear-gradient(135deg,rgba(78,222,163,0.08),rgba(78,222,163,0.03));border:1px solid rgba(78,222,163,0.20);">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(78,222,163,0.15);">
                    <span class="material-symbols-outlined" style="color:#4edea3;font-size:22px;">account_balance_wallet</span>
                </div>
                <div>
                    <div class="font-headline font-black text-sm" style="color:#4edea3;">QUANT PORTFOLIO</div>
                    <div class="text-[10px] text-on-surface-variant/60 mt-0.5">Z-score ranking · Long-short · Vol-adjusted sizing</div>
                </div>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-on-surface-variant transition-colors">arrow_forward</span>
        </a>
        <a href="compare.html" class="flex items-center justify-between p-4 rounded-xl group transition-all duration-200 hover:scale-[1.01]"
           style="background:linear-gradient(135deg,rgba(249,212,35,0.08),rgba(249,212,35,0.03));border:1px solid rgba(249,212,35,0.25);">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(249,212,35,0.15);">
                    <span class="material-symbols-outlined" style="color:#f9d423;font-size:22px;">compare_arrows</span>
                </div>
                <div>
                    <div class="font-headline font-black text-sm" style="color:#f9d423;">COMPARE STOCKS</div>
                    <div class="text-[10px] text-on-surface-variant/60 mt-0.5">Stack up to 3 stocks side-by-side with verdict</div>
                </div>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-on-surface-variant transition-colors">arrow_forward</span>
        </a>
    </div>

    <!-- Prediction Accuracy — HIDDEN for minimal UI -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 hidden" id="accuracySection" style="display:none;">
        <div class="bg-surface-container-low rounded-xl border border-outline-variant/10 p-6 text-center">
            <p class="text-on-surface-variant text-[10px] uppercase tracking-widest font-bold mb-2">1D Hit Rate</p>
            <div class="text-3xl font-black font-headline text-secondary" id="accuracy1D">--</div>
            <p class="text-[10px] text-on-surface-variant mt-2" id="accuracy1DCount">0 predictions</p>
        </div>
        <div class="bg-surface-container-low rounded-xl border border-outline-variant/10 p-6 text-center">
            <p class="text-on-surface-variant text-[10px] uppercase tracking-widest font-bold mb-2">3D Hit Rate</p>
            <div class="text-3xl font-black font-headline text-primary" id="accuracy3D">--</div>
            <p class="text-[10px] text-on-surface-variant mt-2" id="accuracy3DCount">0 predictions</p>
        </div>
        <div class="bg-surface-container-low rounded-xl border border-outline-variant/10 p-6 text-center">
            <p class="text-on-surface-variant text-[10px] uppercase tracking-widest font-bold mb-2">20D Hit Rate</p>
            <div class="text-3xl font-black font-headline text-on-surface" id="accuracy20D">--</div>
            <p class="text-[10px] text-on-surface-variant mt-2" id="accuracy20DCount">0 predictions</p>
        </div>
    </div>

    <!-- Suggested Stocks — HIDDEN for minimal UI -->
    <div class="mb-8 hidden" id="suggestedSection" style="display:none;">
        <h2 class="font-headline font-bold text-lg text-on-surface mb-4">Suggested Stocks</h2>
        <div id="suggestedStocks" class="grid grid-cols-1 md:grid-cols-3 gap-4"></div>
    </div>

    <!-- ============ LIVE FEED — News ⇄ Buzz toggle ============ -->
    <section class="mb-6 px-2" id="liveNewsWire">
      <!-- Source toggle (News vs Buzz) — primary axis for first-time users -->
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        <div class="w-1.5 h-1.5 rounded-full bg-error animate-pulse"></div>
        <h3 class="text-[10px] font-black tracking-[0.25em] uppercase text-on-surface-variant">Live Feed</h3>
        <div id="feedSourceToggle" class="ml-3 inline-flex rounded-full p-0.5"
             style="background:rgba(255,255,255,0.04);border:1px solid var(--b1);">
          <button class="src-pill active" data-src="news" title="Curated press, filings &amp; price-spike movers">
            <span class="material-symbols-outlined" style="font-size:13px;vertical-align:-2px;">article</span>
            News
          </button>
          <button class="src-pill" data-src="buzz" title="Verified X handles + serious Reddit/Telegram chatter">
            <span class="material-symbols-outlined" style="font-size:13px;vertical-align:-2px;">forum</span>
            Buzz
          </button>
        </div>
        <div class="h-[1px] flex-1 bg-outline-variant/20"></div>
        <div class="flex gap-1" id="newsWireFilters">
          <button class="news-pill active" data-flt="all">All</button>
          <button class="news-pill" data-flt="policy">Policy</button>
          <button class="news-pill" data-flt="earnings">Earnings</button>
          <button class="news-pill" data-flt="movers">Movers</button>
          <button class="news-pill" data-flt="smallcap">Small/Mid Cap</button>
        </div>
        <span class="text-[9px] text-on-surface-variant/40 font-mono ml-2" id="newsWireUpdated">fetching…</span>
      </div>
      <style>
        .src-pill { padding:5px 14px; font-size:11px; font-weight:800; border-radius:999px;
          background:transparent; color:var(--t2); border:0; cursor:pointer;
          letter-spacing:0.04em; transition:all 0.15s; display:inline-flex; align-items:center; gap:4px; }
        .src-pill:hover { color:var(--t1); }
        .src-pill.active { background:linear-gradient(135deg,#2dd4aa,#1faa83); color:#06120e;
          box-shadow:0 4px 14px rgba(45,212,170,0.25); }
      </style>
      <style>
        .news-pill { padding:3px 9px; font-size:10px; font-weight:700; border-radius:14px; background:transparent;
          color:var(--t2); border:1px solid var(--b1); cursor:pointer; transition:all 0.12s; }
        .news-pill:hover { color:var(--t1); border-color:var(--b2); }
        .news-pill.active { background:var(--info-dim); color:var(--info); border-color:var(--info-border); }
        .wire-row { display:grid; grid-template-columns:88px 1fr auto auto; gap:12px; align-items:center;
          padding:8px 12px; border-radius:6px; background:var(--s0); border:1px solid var(--b0);
          transition:border-color 0.12s, background 0.12s; cursor:pointer; }
        .wire-row:hover { border-color:var(--b2); background:var(--s1); }
        .wire-row + .wire-row { margin-top:6px; }
        .wire-time { font-size:10px; font-family:var(--font-mono); color:var(--t3); white-space:nowrap; }
        .wire-title { font-size:13px; font-weight:600; color:var(--t1); line-height:1.35; overflow:hidden;
          display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
        .wire-meta { font-size:9.5px; color:var(--t3); margin-top:2px; }
        .wire-tag { font-size:9px; font-weight:800; padding:2px 7px; border-radius:3px; white-space:nowrap;
          letter-spacing:0.04em; text-transform:uppercase; }
        .wire-tag.bull { background:var(--bull-dim); color:var(--bull); }
        .wire-tag.bear { background:var(--bear-dim); color:var(--bear); }
        .wire-tag.neut { background:rgba(138,148,168,0.10); color:var(--t2); }
        .wire-alpha { font-family:var(--font-mono); font-size:13px; font-weight:800; min-width:32px; text-align:right; }
        .wire-alpha.high { color:var(--bull); }
        .wire-alpha.mid { color:var(--caution); }
        .wire-alpha.low { color:var(--t3); }
        @media (max-width:768px) {
          .wire-row { grid-template-columns:1fr auto; gap:6px; }
          .wire-time { display:none; }
        }
      </style>
      <div id="newsWireList">
        <div class="skeleton" style="height:42px;border-radius:6px;margin-bottom:6px;"></div>
        <div class="skeleton" style="height:42px;border-radius:6px;margin-bottom:6px;"></div>
        <div class="skeleton" style="height:42px;border-radius:6px;margin-bottom:6px;"></div>
        <div class="skeleton" style="height:42px;border-radius:6px;"></div>
      </div>
    </section>
    <script>
    (function() {
      // Live Feed — News (press + price-spike movers) or Buzz (verified social).
      // News:  /api/news/fast + /api/movers/spike
      // Buzz:  /api/social/feed (verified X / serious Reddit / Telegram)
      let _wireFlt = 'all';
      let _wireSrc = 'news';   // 'news' | 'buzz'
      let _wireData = [];

      function ago(hours) {
        if (hours == null) return '';
        if (hours < 1) return Math.round(hours * 60) + 'm';
        if (hours < 24) return Math.round(hours) + 'h';
        return Math.round(hours / 24) + 'd';
      }
      function escape(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      }
      function classify(it) {
        const hay = ((it.title || '') + ' ' + (it.summary || '') + ' ' + (it.event_type || '') + ' ' + (it.feed || '')).toLowerCase();
        const tickers = Array.isArray(it.tickers) ? it.tickers : (it.companies ? String(it.companies).split(',').filter(Boolean) : []);
        const isMover = it._mover === true || /jumps? \d|surges? \d|plunges? \d|crashes? \d|gain(ed|s)? \d|fell \d|rallies? \d|down \d+%|up \d+%|hit (upper|lower) circuit/.test(hay);
        const isPolicy = /\brbi\b|\bsebi\b|policy|circular|notification|government|ministry|cabinet|union budget|gst|nppa|trai|spectrum|subsidy/.test(hay) ||
                         (it.event_type || '').toLowerCase() === 'policy';
        const isEarnings = /q[1-4]|quarter|earnings|profit|revenue|ebitda|guidance|results/.test(hay) ||
                           (it.event_type || '').toLowerCase() === 'earnings';
        const isOrderWin = /order win|contract|bagged|awarded|secured|loi/.test(hay) ||
                           (it.event_type || '').toLowerCase() === 'order_win';
        // Small/mid cap heuristic: any explicitly tagged "smallcap" / "midcap", OR any
        // ticker that's NOT in the well-known large-cap set
        const LARGE = new Set(['RELIANCE','TCS','INFY','HDFCBANK','ICICIBANK','SBIN','BHARTIARTL','ITC','LT','HINDUNILVR','MARUTI','SUNPHARMA','AXISBANK','BAJFINANCE','TATASTEEL','ASIANPAINT','KOTAKBANK','TITAN','WIPRO','ULTRACEMCO','M&M','POWERGRID','NTPC','BAJAJFINSV','HCLTECH','ADANIPORTS']);
        const isSmallMid = /\b(small.?cap|mid.?cap|multibagger|microcap)\b/i.test(hay) ||
                           (tickers.length && tickers.some(t => !LARGE.has(t.trim().toUpperCase())));
        return { isMover, isPolicy, isEarnings, isOrderWin, isSmallMid, tickers };
      }
      function passesFilter(it, flt, c) {
        if (flt === 'all') return true;
        if (flt === 'policy') return c.isPolicy;
        if (flt === 'earnings') return c.isEarnings || c.isOrderWin;
        if (flt === 'movers') return c.isMover || it._mover;
        if (flt === 'smallcap') return c.isSmallMid;
        return true;
      }
      function senTag(s) {
        s = (s || '').toLowerCase();
        if (s === 'bullish' || s === 'positive') return { cls: 'bull', label: 'Bullish' };
        if (s === 'bearish' || s === 'negative') return { cls: 'bear', label: 'Bearish' };
        return { cls: 'neut', label: 'Neutral' };
      }
      function alphaBucket(a) {
        if (a == null) return null;
        if (a >= 65) return 'high';
        if (a >= 40) return 'mid';
        return 'low';
      }
      function renderWire() {
        const list = document.getElementById('newsWireList');
        if (!list) return;
        const items = _wireData
          .map(it => ({ it, c: classify(it) }))
          .filter(x => passesFilter(x.it, _wireFlt, x.c))
          .slice(0, 25);
        if (!items.length) {
          list.innerHTML = '<div style="text-align:center;padding:24px;color:var(--t3);font-size:12px;">No news matches this filter yet.</div>';
          return;
        }
        list.innerHTML = items.map(({ it, c }, idx) => {
          const sen = senTag(it.sentiment);
          const tickers = c.tickers.slice(0, 4).map(t => `<a href="stock.html?t=${escape(t)}" onclick="event.stopPropagation();" style="color:var(--info);font-family:var(--font-mono);font-size:10px;font-weight:700;text-decoration:none;">${escape(t)}</a>`).join(' · ');
          const alphaVal = it.alpha_score != null ? Math.round(it.alpha_score) : (it.magnitude != null ? Math.round(it.magnitude) : null);
          const bucket = alphaBucket(alphaVal);
          const tags = [];
          if (c.isPolicy)   tags.push('<span class="wire-tag" style="background:rgba(108,138,255,0.12);color:var(--info);">POLICY</span>');
          if (c.isOrderWin) tags.push('<span class="wire-tag" style="background:rgba(52,211,153,0.12);color:var(--bull);">ORDER</span>');
          if (c.isEarnings) tags.push('<span class="wire-tag" style="background:rgba(251,191,36,0.12);color:var(--caution);">EARNINGS</span>');
          if (it._mover)    tags.push('<span class="wire-tag" style="background:rgba(251,113,133,0.12);color:var(--bear);">MOVER</span>');
          if (it.confidence === 'high')   tags.push('<span class="wire-tag" style="background:rgba(52,211,153,0.18);color:var(--bull);">HIGH CONFIDENCE</span>');
          else if (it.confidence === 'medium') tags.push('<span class="wire-tag" style="background:rgba(251,191,36,0.18);color:var(--caution);">MID CONF.</span>');
          if (it.sector) tags.push(`<span class="wire-tag" style="background:rgba(148,163,184,0.14);color:var(--t2);">${escape(it.sector)}</span>`);

          const hasDetails = it._mover && (Array.isArray(it.reasoning) && it.reasoning.length);
          const link = it.link || '#';
          // Movers: row click toggles details (link is '#'). News: row click opens link.
          const onClick = hasDetails
            ? `onclick="(function(el){var d=el.querySelector('.wire-details');if(d){d.style.display=d.style.display==='block'?'none':'block';var c=el.querySelector('.wire-chev');if(c)c.style.transform=d.style.display==='block'?'rotate(90deg)':'rotate(0deg)';}})(this)"`
            : (link === '#' ? '' : `onclick="window.open('${escape(link)}','_blank','noopener')"`);
          const chev = hasDetails ? '<span class="wire-chev material-symbols-outlined" style="font-size:14px;color:var(--t3);transition:transform .15s;display:inline-block;vertical-align:-3px;margin-right:2px;">chevron_right</span>' : '';

          let detailsHtml = '';
          if (hasDetails) {
            const comp = it.alpha_components || {};
            const compBar = (label, val, max, color) => `
              <div style="flex:1;min-width:90px;">
                <div style="font-size:9px;color:var(--t3);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:3px;">${label}</div>
                <div style="display:flex;align-items:center;gap:6px;">
                  <div style="flex:1;height:5px;background:rgba(148,163,184,0.12);border-radius:3px;overflow:hidden;">
                    <div style="width:${Math.min(100, (val/max)*100)}%;height:100%;background:${color};border-radius:3px;"></div>
                  </div>
                  <span style="font-family:var(--font-mono);font-size:10px;color:var(--t2);min-width:28px;text-align:right;">${val}/${max}</span>
                </div>
              </div>`;

            const reasoningHtml = (it.reasoning || []).map(b => {
              const icon = ({move:'trending_up', volume:'graphic_eq', news:'article', no_news:'visibility_off', sector:'category'})[b.kind] || 'info';
              const linkPart = b.link ? ` <a href="${escape(b.link)}" target="_blank" rel="noopener" onclick="event.stopPropagation();" style="color:var(--info);text-decoration:none;font-size:10px;">↗ open</a>` : '';
              return `<div style="display:flex;gap:8px;align-items:flex-start;font-size:11px;color:var(--t2);line-height:1.5;">
                <span class="material-symbols-outlined" style="font-size:14px;color:var(--t3);margin-top:1px;">${icon}</span>
                <div>${escape(b.label)}${linkPart}</div>
              </div>`;
            }).join('');

            const sugg = (it.suggested || []).slice(0, 4);
            const suggHtml = sugg.length ? `
              <div style="margin-top:10px;">
                <div style="font-size:9px;color:var(--t3);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Suggested · sympathy plays</div>
                <div style="display:flex;flex-wrap:wrap;gap:6px;">
                  ${sugg.map(s => {
                    const ppct = s.pct_change;
                    const pSign = ppct == null ? '' : (ppct >= 0 ? '+' : '');
                    const pCol  = ppct == null ? 'var(--t2)' : (ppct >= 0 ? 'var(--bull)' : 'var(--bear)');
                    const pTxt  = ppct == null ? '' : ` <span style="color:${pCol};">${pSign}${ppct.toFixed(1)}%</span>`;
                    return `<a href="stock.html?t=${escape(s.ticker)}" onclick="event.stopPropagation();" title="${escape(s.reason||'')}" style="display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border:1px solid var(--b1);border-radius:999px;background:var(--s1);text-decoration:none;font-family:var(--font-mono);font-size:10px;color:var(--t1);font-weight:600;">${escape(s.ticker)}${pTxt}</a>`;
                  }).join('')}
                </div>
              </div>` : '';

            detailsHtml = `<div class="wire-details" style="display:none;grid-column:1 / -1;margin-top:8px;padding:12px;background:var(--s0);border:1px solid var(--b1);border-radius:8px;">
              <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:10px;">
                ${compBar('Magnitude', comp.magnitude||0, 40, 'var(--info)')}
                ${compBar('Volume',    comp.volume||0,    30, 'var(--bull)')}
                ${compBar('News',      comp.news||0,      20, 'var(--caution)')}
                ${compBar('Sector',    comp.sector||0,    10, '#a78bfa')}
              </div>
              <div style="display:flex;flex-direction:column;gap:6px;">${reasoningHtml}</div>
              ${suggHtml}
            </div>`;
          }

          return `<div class="wire-row" ${onClick} style="${hasDetails ? 'cursor:pointer;align-items:start;' : ''}">
            <div class="wire-time">${escape(ago(it.age_hours))} ago</div>
            <div>
              <div class="wire-title">${chev}${escape(it.title || it.summary || 'Untitled')}</div>
              <div class="wire-meta">
                <span style="text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">${escape((it.feed || it.source || 'news').slice(0, 28))}</span>
                ${tickers ? ' · ' + tickers : ''}
                ${tags.length ? ' · ' + tags.join(' ') : ''}
              </div>
            </div>
            <div><span class="wire-tag ${sen.cls}">${sen.label}</span></div>
            <div class="wire-alpha ${bucket || 'low'}" title="Alpha score: 0-100. Higher = stronger conviction (move + volume + news + sector).">${alphaVal != null ? alphaVal : '—'}</div>
            ${detailsHtml}
          </div>`;
        }).join('');
      }
      async function refreshWire() {
        try {
          if (_wireSrc === 'buzz') {
            // Verified social chatter — X handles only, serious Reddit/Telegram
            const r = await fetch('/api/social/feed?hours=12&limit=80').then(x => x.json()).catch(() => ({}));
            const items = ((r && r.data) || []).map(p => {
              const text = (p.text || p.title || '').slice(0, 240);
              const handleLabel = p.platform === 'x' ? '@' + p.handle
                                : p.platform === 'reddit' ? 'r/' + p.handle
                                : 't.me/' + p.handle;
              const ageH = p.posted_at
                ? Math.max(0.01, (Date.now() - new Date(p.posted_at).getTime()) / 3600000)
                : 0.5;
              const sev = (p.serious_score || 0) >= 50 ? 'high'
                        : (p.serious_score || 0) >= 25 ? 'medium' : null;
              return {
                title: text || '(no text)',
                summary: text,
                tickers: p.tickers || [],
                feed: handleLabel,
                source: handleLabel,
                sentiment: 'neutral',
                age_hours: ageH,
                alpha_score: Math.min(100, Math.round((p.serious_score || 0) + (p.engagement ? Math.log10(p.engagement) * 8 : 0))),
                confidence: sev,
                link: p.url,
                _buzz: true,
                _platform: p.platform,
              };
            });
            _wireData = items;
          } else {
            // exclude_social=1 keeps chatter out of NEWS so curated press dominates.
            const [news, movers] = await Promise.all([
              fetch('/api/news/fast?limit=80&exclude_social=1').then(r => r.json()).catch(() => ({})),
              fetch('/api/movers/spike?limit=15').then(r => r.json()).catch(() => ({})),
            ]);
            const newsList = (news && news.data) || [];
            const moverList = ((movers && movers.data) || []).map(m => {
              const pct = m.pct_change || 0;
              const dir = pct >= 0 ? 'jumps' : 'falls';
              const newsBullet = (m.reasoning || []).find(b => b.kind === 'news');
              const title = newsBullet
                ? `${m.ticker} ${dir} ${Math.abs(pct).toFixed(1)}% — ${newsBullet.label.replace(/^Headline \([^)]+\):\s*/, '')}`
                : `${m.ticker} ${dir} ${Math.abs(pct).toFixed(1)}% intraday`;
              return {
                ...m, _mover: true,
                title,
                tickers: [m.ticker],
                feed: 'price_scanner',
                sentiment: pct >= 0 ? 'bullish' : 'bearish',
                age_hours: 0.05,
              };
            });
            _wireData = [...moverList, ...newsList];
            // Hero "right now" tile — top mover snapshot (news source only)
            paintHeroLive(moverList[0], moverList.length);
          }
          const upd = document.getElementById('newsWireUpdated');
          if (upd) upd.textContent = `${_wireData.length} ${_wireSrc === 'buzz' ? 'posts' : 'items'} · ${new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })}`;
          renderWire();
        } catch (e) {
          console.warn('feed refresh failed:', e);
        }
      }

      function paintHeroPanels(topEvent, topTrades, pulse) {
        paintHeroPanelEvent(topEvent);
        paintHeroPanelTrades(topTrades);
        paintHeroPanelState(pulse);
      }

      function paintHeroPanelEvent(event) {
        const body = document.getElementById('heroPanelEventBody');
        if (!body) return;
        if (!event) {
          body.innerHTML = '<div style="color:var(--t2);font-size:12px;line-height:1.5;opacity:0.7;">Analyzing live market data...</div>';
          return;
        }
        try {
          const impact = event.impact || 'medium';
          const impactColor = impact === 'high' ? '#ff7a8a' : impact === 'medium' ? '#f9d423' : '#4edea3';
          const impactLabel = impact === 'high' ? 'HIGH IMPACT' : impact === 'medium' ? 'MED IMPACT' : 'LOW IMPACT';
          const eventType = (event.event_type || 'news').toUpperCase().replace(/_/g, ' ');
          const headline = event.headline || event.title || 'Market catalyst detected';

          body.innerHTML = `
            <h3 class="text-lg font-black mb-3 text-on-surface leading-snug">${escape(headline.slice(0, 100))}</h3>
            <div class="flex gap-2 mb-4 flex-wrap">
              <span class="text-[9px] px-2 py-1 rounded-full font-bold uppercase" style="background:rgba(200,150,100,0.15);color:#c89664;">${escape(eventType)}</span>
              <span class="text-[9px] px-2 py-1 rounded-full font-bold uppercase" style="background:rgba(${impactColor.slice(1).match(/.{1,2}/g).join(',')},0.15);color:${impactColor};">${impactLabel}</span>
            </div>
            <div class="text-xs text-on-surface-variant/80 leading-relaxed">
              <p>${escape((event.summary || 'Market impact expected').slice(0, 160))}</p>
            </div>
          `;
        } catch(e) {
          body.innerHTML = '<div style="color:var(--t2);font-size:12px;">Unable to load event data</div>';
        }
      }

      function paintHeroPanelTrades(trades) {
        const body = document.getElementById('heroPanelTradesBody');
        if (!body) return;
        const items = (trades || []).slice(0, 3);
        if (!items.length) {
          body.innerHTML = '<div style="color:var(--t2);font-size:11px;opacity:0.7;">Refreshing signals...</div>';
          return;
        }
        body.innerHTML = items.map(t => {
          const alphaColor = (t.alpha_score || 0) >= 75 ? '#4edea3' : (t.alpha_score || 0) >= 60 ? '#f9d423' : '#ff7a8a';
          return `
            <a href="stock.html?t=${escape(t.ticker)}" style="display:block;text-decoration:none;color:inherit;padding:0.75rem;background:rgba(255,255,255,0.02);border-radius:8px;border:1px solid rgba(255,255,255,0.04);hover:border-color:${alphaColor}33;">
              <div class="flex items-center justify-between mb-1">
                <span class="font-bold text-sm">${escape(t.ticker)}</span>
                <span class="text-[10px] font-mono font-bold" style="color:${alphaColor};">${Math.round(t.alpha_score || 0)}</span>
              </div>
              <div class="text-[10px] text-on-surface-variant">${Math.round((t.confidence || 0) * 100)}% Confidence</div>
            </a>
          `;
        }).join('');
      }

      function paintHeroPanelState(pulse) {
        const body = document.getElementById('heroPanelStateBody');
        if (!body) return;
        if (!pulse) {
          body.innerHTML = '<div style="color:var(--t2);font-size:11px;opacity:0.7;">Loading market state...</div>';
          return;
        }
        const trendEmoji = pulse.trendLabel.includes('Bullish') ? '📈' : '📉';
        const trendColor = pulse.trendLabel.includes('Bullish') ? '#4edea3' : '#ff7a8a';
        body.innerHTML = `
          <div style="text-align:center;margin-bottom:1rem;">
            <div style="font-size:36px;margin-bottom:0.5rem;">${trendEmoji}</div>
            <div class="text-xs text-on-surface-variant/70 mb-1">${pulse.trendLabel.includes('Bullish') ? 'BULLISH' : 'BEARISH'}</div>
            <div class="text-base font-black" style="color:${trendColor};">${pulse.greenCount || 0}/4 Indices Up</div>
          </div>
          <div class="space-y-2 text-xs">
            <div class="flex justify-between"><span class="text-on-surface-variant/70">Breadth</span><span class="font-mono font-bold">${pulse.greenCount >= 2 ? '62%' : '38%'}</span></div>
            <div class="flex justify-between"><span class="text-on-surface-variant/70">VIX</span><span class="font-mono font-bold" style="color:${pulse.fearColor};">${pulse.vixVal}</span></div>
          </div>
        `;
      }
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('#newsWireFilters .news-pill').forEach(b => {
          b.addEventListener('click', () => {
            document.querySelectorAll('#newsWireFilters .news-pill').forEach(x => x.classList.remove('active'));
            b.classList.add('active');
            _wireFlt = b.dataset.flt;
            renderWire();
          });
        });
        // News ⇄ Buzz source toggle
        document.querySelectorAll('#feedSourceToggle .src-pill').forEach(b => {
          b.addEventListener('click', () => {
            if (b.classList.contains('active')) return;
            document.querySelectorAll('#feedSourceToggle .src-pill').forEach(x => x.classList.remove('active'));
            b.classList.add('active');
            _wireSrc = b.dataset.src;
            const list = document.getElementById('newsWireList');
            if (list) list.innerHTML = '<div class="skeleton" style="height:42px;border-radius:6px;margin-bottom:6px;"></div><div class="skeleton" style="height:42px;border-radius:6px;margin-bottom:6px;"></div><div class="skeleton" style="height:42px;border-radius:6px;"></div>';
            refreshWire();
          });
        });
        refreshWire();
        setInterval(refreshWire, 60000);
      });
    })();
    </script>
    <!-- ============ END LIVE NEWS WIRE ============ -->

    <!-- ============ POLICY PULSE ============ -->
    <section id="policyPulseSection" class="mb-8" style="display:none;">
      <div class="flex items-center gap-2 mb-3">
        <span class="material-symbols-outlined" style="font-size:16px;color:#a78bfa;">gavel</span>
        <h3 class="text-[10px] font-black tracking-[0.25em] uppercase" style="color:#a78bfa;">Policy Pulse</h3>
        <span class="text-[10px] text-on-surface-variant/50 font-mono">RBI · SEBI · Budget · Ministry</span>
        <div class="h-[1px] flex-1 bg-outline-variant/20"></div>
        <span id="policyCount" class="text-[10px] font-mono text-on-surface-variant/40"></span>
      </div>
      <div id="policyList" class="space-y-2"></div>
    </section>
    <!-- ============ END POLICY PULSE ============ -->

    <!-- Main Grid: Events + Signals -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6 px-2">
        <!-- Latest Events (2 columns) — compact alpha-scored wire rows -->
        <div class="lg:col-span-2">
            <div class="flex items-center gap-2 mb-3">
                <h2 class="text-[10px] font-black tracking-[0.25em] uppercase text-on-surface-variant">Latest Events</h2>
                <div class="h-[1px] flex-1 bg-outline-variant/20"></div>
                <a href="events.html" class="text-[10px] text-primary font-bold hover:underline">All events →</a>
            </div>
            <div id="latestEvents" class="space-y-1.5">
                <!-- Skeleton placeholders — replaced by real data on load -->
                <div class="bg-surface-container rounded-lg border border-outline-variant/10 p-4 flex gap-4">
                    <span class="skeleton flex-shrink-0" style="width:48px;height:48px;border-radius:8px;min-width:48px;"></span>
                    <div class="flex-1 space-y-2 py-1">
                        <span class="skeleton" style="height:10px;width:25%;"></span>
                        <span class="skeleton" style="height:14px;width:70%;"></span>
                        <span class="skeleton" style="height:10px;width:100%;"></span>
                        <span class="skeleton" style="height:10px;width:55%;"></span>
                    </div>
                </div>
                <div class="bg-surface-container rounded-lg border border-outline-variant/10 p-4 flex gap-4">
                    <span class="skeleton flex-shrink-0" style="width:48px;height:48px;border-radius:8px;min-width:48px;"></span>
                    <div class="flex-1 space-y-2 py-1">
                        <span class="skeleton" style="height:10px;width:30%;"></span>
                        <span class="skeleton" style="height:14px;width:80%;"></span>
                        <span class="skeleton" style="height:10px;width:100%;"></span>
                        <span class="skeleton" style="height:10px;width:45%;"></span>
                    </div>
                </div>
                <div class="bg-surface-container rounded-lg border border-outline-variant/10 p-4 flex gap-4">
                    <span class="skeleton flex-shrink-0" style="width:48px;height:48px;border-radius:8px;min-width:48px;"></span>
                    <div class="flex-1 space-y-2 py-1">
                        <span class="skeleton" style="height:10px;width:20%;"></span>
                        <span class="skeleton" style="height:14px;width:65%;"></span>
                        <span class="skeleton" style="height:10px;width:95%;"></span>
                        <span class="skeleton" style="height:10px;width:60%;"></span>
                    </div>
                </div>
                <div class="bg-surface-container rounded-lg border border-outline-variant/10 p-4 flex gap-4">
                    <span class="skeleton flex-shrink-0" style="width:48px;height:48px;border-radius:8px;min-width:48px;"></span>
                    <div class="flex-1 space-y-2 py-1">
