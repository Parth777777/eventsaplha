# EventAlpha Configuration
# Copy this file to .env and fill in your values

# ============ DATABASE ============
# Option 1: Supabase PostgreSQL (recommended for production)
# Get this from: supabase.com → Project Settings → Database → Connection String (URI)
DATABASE_URL=

# Option 2: Leave empty to use local SQLite (development only)
# If DATABASE_URL is empty, SQLite at data/eventalpha.db is used automatically

# ============ AUTH (Multi-user) ============
# For Supabase Auth (production): get these from supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# For local dev: leave SUPABASE_URL empty → uses SQLite local auth automatically

# ============ LLM CROSS-VERIFICATION ============
# Groq API Key (free: 14,400 req/day) - used for cross-verifying uncertain signals
# Get from: console.groq.com → API Keys
# Leave empty to use keyword-only analysis (still works, ~70% accuracy)
GROQ_API_KEY=

# ============ NEWS SOURCES ============
# NewsAPI.org - Free tier: 100 requests/day
# Get this from: newsapi.org/register
NEWSAPI_KEY=

# ============ DISCORD ALERTS ============
# Discord Webhook URL for sending trading signal alerts
# How to get: Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ============ TELEGRAM ALERTS ============
# Telegram Bot Token
# How to get: Open Telegram → search @BotFather → /newbot → follow prompts → copy token
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (your personal chat or channel)
# How to get: Message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
# Find "chat":{"id": YOUR_CHAT_ID}
TELEGRAM_CHAT_ID=

# ============ SCRAPER SETTINGS ============
# How often to run the scraper (in minutes)
SCRAPER_INTERVAL=10

# ============ APP SETTINGS ============
# Secret key for Flask sessions + JWT signing (generate a random string)
SECRET_KEY=change-this-to-a-random-string

# Port (default 5000, Render sets this automatically)
PORT=5000

# ============================================================
# Phase 1.5 — Social + Observability + Admin
# ============================================================

# ============ REDDIT (PRAW) ============
# Free. Create an app at https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=alphaevent-scraper/0.1 by yourname
# Optional CSV of subreddits (defaults to curated Indian investing subs)
REDDIT_SUBS=

# ============ TWITTER / X ============
# Primary path: rotate through public Nitter instances (free).
NITTER_INSTANCES=https://nitter.net,https://nitter.privacydev.net,https://nitter.poast.org
# Optional paid X API v2 basic tier bearer token — used if set.
X_BEARER_TOKEN=
# Optional CSV of handles (defaults to curated FinTwit)
X_HANDLES=

# ============ TELEGRAM ============
# From https://my.telegram.org — needed for telethon user session
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=alphaevent
# CSV of public channel handles (with or without @)
TELEGRAM_CHANNELS=

# ============ CACHE (optional) ============
# Redis URL for hot-endpoint caching. If empty, in-process cache is used.
REDIS_URL=

# ============ GROQ MODEL OVERRIDE (optional) ============
GROQ_MODEL=llama-3.3-70b-versatile

# ============ ADMIN ============
# Shared secret for protected admin endpoints (e.g. /api/admin/init_ext_schema)
ADMIN_SECRET=change-me-admin
